    "index.d.ts",
    "LICENSE"
  ],
  "types": "index.d.ts",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^8.57.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier -w .",
    "test": "jest --runInBand",
    "prepublishOnly": "npm run lint && npm run test && npm run fmt"
  }
